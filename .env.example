# Copy to .env.local for local builds. Both values are optional and read at build time.

# Web app host for this brand (account opening and log in).
#   unset: "Open account" buttons scroll to the lead form and no "Log in" link is shown
#   set:   "Open account" and "Log in" go to this URL
VITE_APP_URL=

# Public origin of this landing page, without a trailing slash, for absolute Open Graph and canonical URLs.
# Example: https://vyomma.example.com
VITE_SITE_URL=
